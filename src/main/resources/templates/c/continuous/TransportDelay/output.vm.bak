          double targetTime_${index} = model.time - ${delayTime.name}($i,$j);
          if(targetTime_${index} <= 0 || Block${blockId}tout[${index}][0] < 0) {
            ${outputSignal.name}($i,$j) = ${initialOutput.name}($i,$j);
          } else {
            int foundIndex_${index} = -1;
            #set($bufferSizeMax = $bufferSize.data.intValue - 1)
            for(int k=0; k<${bufferSizeMax}; k++) {
              if(Block${blockId}tout[${index}][k+1] < 0) break;
              if(Block${blockId}tout[${index}][k] >= targetTime_${index} && 
                 targetTime_${index} >= Block${blockId}tout[${index}][k+1]) {
                foundIndex_${index} = k;
                break;
              }
            }
            if(foundIndex_${index} >= 0) {
              double t1 = Block${blockId}tout[${index}][foundIndex_${index}];
              double t2 = Block${blockId}tout[${index}][foundIndex_${index}+1];
              double y1 = Block${blockId}yout[${index}][foundIndex_${index}];
              double y2 = Block${blockId}yout[${index}][foundIndex_${index}+1];
              double alpha = 0.0;
              if(fabs(t1 - t2) > 1e-10) {
                alpha = (targetTime_${index} - t2) / (t1 - t2);
                alpha = fmax(0.0, fmin(1.0, alpha));
              }
              ${outputSignal.name}($i,$j) = alpha * y1 + (1.0 - alpha) * y2;
            } else {
              if(Block${blockId}tout[${index}][0] >= targetTime_${index}) {
                ${outputSignal.name}($i,$j) = Block${blockId}yout[${index}][0];
              } else {
                ${outputSignal.name}($i,$j) = ${initialOutput.name}($i,$j);
              }
            }
          }
