## ======================================================================================
## Improved PID Controller Output Template
## Leverages shared macros for better consistency and readability
## ======================================================================================
#parse("c/shared/data_type_macros.vm")

## Set up template context
#set($operationType = "output")
#parse("c/shared/block_header.vm")

## Block-specific variables
#set($blockId = $block.getBlockId())
#set($outputVar = $block.getOutputPortVariable(0))
#set($inputSignal = #getInputSignal(0))

## PID Controller computation
#if(#isScalar($cparaP))
    #if(#isScalar($inputSignal))
        ## Scalar PID computation
        if(sfcnIsMajorStep()) {
            Block${blockId}save_data[0] = ${cparaP.getName()} * ${inputSignal.getName()};
            Block${blockId}save_data[1] = ${cparaD.getName()} * ${inputSignal.getName()};
            Block${blockId}save_data[2] = ${cparaI.getName()} * ${inputSignal.getName()};
            Block${blockId}save_data[3] = (Block${blockId}save_data[1] - ${stateFilter.getName()}) * ${cparaN.getName()};
            double Block${blockId}_intermediate = Block${blockId}save_data[0] + ${stateIntegral.getName()} + Block${blockId}save_data[3];

            ## Handle external reset
            #if($externalReset == "on")
            if(${resetSig}) {
                memset(Block${blockId}save_data, 0, sizeof(Block${blockId}save_data));
                Block${blockId}_intermediate = 0;
            }
            #end

            ## Apply output saturation if enabled
            #if($limitOutput == "on")
            ${outputVar} = (Block${blockId}_intermediate > ${upperSaturationLimit.getName()}) ? ${upperSaturationLimit.getName()} : 
                         ((Block${blockId}_intermediate < ${lowerSaturationLimit.getName()}) ? ${lowerSaturationLimit.getName()} : Block${blockId}_intermediate);
            #else
            ${outputVar} = Block${blockId}_intermediate;
            #end
        }
        
    #else
        ## Matrix input, scalar PID parameters
        #set($height = $inputSignal.getHeight())
        #set($width = $inputSignal.getWidth())
        #set($hMax = $height - 1)
        #set($wMax = $width - 1)
        #set($m5 = 5)
        
        #foreach($i in [0..$hMax])
            #foreach($j in [0..$wMax])
        if(sfcnIsMajorStep()) {
            Block${blockId}save_data[${i}][${j}*${m5}] = ${cparaP.getName()} * ${inputSignal.getName()}(${i}, ${j});
            Block${blockId}save_data[${i}][${j}*${m5}+1] = ${cparaD.getName()} * ${inputSignal.getName()}(${i}, ${j});
            Block${blockId}save_data[${i}][${j}*${m5}+2] = ${cparaI.getName()} * ${inputSignal.getName()}(${i}, ${j});
        }
        double Block${blockId}_intermediate = Block${blockId}save_data[${i}][${j}*${m5}] + 
                                             ${stateIntegral.getName()}(${i}, ${j}) + 
                                             (Block${blockId}save_data[${i}][${j}*${m5}+1] - ${stateFilter.getName()}(${i}, ${j})) * ${cparaN.getName()};

        ## Handle external reset
        #if($externalReset == "on")
        if(${resetSig}) {
            memset(Block${blockId}save_data, 0, sizeof(Block${blockId}save_data));
            Block${blockId}_intermediate = 0;
        }
        #end

        ## Apply output saturation if enabled
        #if($limitOutput == "on")
        ${outputVar}(${i}, ${j}) = (Block${blockId}_intermediate > ${upperSaturationLimit.getName()}(${i}, ${j})) ? ${upperSaturationLimit.getName()}(${i}, ${j}) : 
                                  ((Block${blockId}_intermediate < ${lowerSaturationLimit.getName()}(${i}, ${j})) ? ${lowerSaturationLimit.getName()}(${i}, ${j}) : Block${blockId}_intermediate);
        #else
        ${outputVar}(${i}, ${j}) = Block${blockId}_intermediate;
        #end
            #end
        #end
    #end
#else
    ## Matrix PID parameters
    #set($height = $cparaP.getHeight())
    #set($width = $cparaP.getWidth())  
    #set($hMax = $height - 1)
    #set($wMax = $width - 1)
    #set($m5 = 5)
    
    #if(#isScalar($inputSignal))
        ## Scalar input, matrix PID parameters
        ${blockId}_loop_i: for(int ${blockId}_i = 0; ${blockId}_i < ${height}; ${blockId}_i++) {
        ${blockId}_loop_j: for(int ${blockId}_j = 0; ${blockId}_j < ${width}; ${blockId}_j++) {
            if(sfcnIsMajorStep()) {
                Block${blockId}save_data[${blockId}_i][${blockId}_j*${m5}] = ${cparaP.getName()}(${blockId}_i, ${blockId}_j) * ${inputSignal.getName()};
                Block${blockId}save_data[${blockId}_i][${blockId}_j*${m5}+1] = ${cparaD.getName()}(${blockId}_i, ${blockId}_j) * ${inputSignal.getName()};
                Block${blockId}save_data[${blockId}_i][${blockId}_j*${m5}+2] = ${cparaI.getName()}(${blockId}_i, ${blockId}_j) * ${inputSignal.getName()};
            }
            double Block${blockId}_intermediate = Block${blockId}save_data[${blockId}_i][${blockId}_j*${m5}] + 
                                                 ${stateIntegral.getName()}(${blockId}_i, ${blockId}_j) + 
                                                 (Block${blockId}save_data[${blockId}_i][${blockId}_j*${m5}+1] - ${stateFilter.getName()}(${blockId}_i, ${blockId}_j)) * ${cparaN.getName()}(${blockId}_i, ${blockId}_j);

            ## Handle external reset
            #if($externalReset == "on")
            if(${resetSig}) {
                memset(Block${blockId}save_data, 0, sizeof(Block${blockId}save_data));
                Block${blockId}_intermediate = 0;
            }
            #end

            ## Apply output saturation if enabled
            #if($limitOutput == "on")
            ${outputVar}(${blockId}_i, ${blockId}_j) = (Block${blockId}_intermediate > ${upperSaturationLimit.getName()}(${blockId}_i, ${blockId}_j)) ? ${upperSaturationLimit.getName()}(${blockId}_i, ${blockId}_j) : 
                                                      ((Block${blockId}_intermediate < ${lowerSaturationLimit.getName()}(${blockId}_i, ${blockId}_j)) ? ${lowerSaturationLimit.getName()}(${blockId}_i, ${blockId}_j) : Block${blockId}_intermediate);
            #else
            ${outputVar}(${blockId}_i, ${blockId}_j) = Block${blockId}_intermediate;
            #end
        }
        }
    #else
        ## Matrix input, matrix PID parameters
        ${blockId}_loop_i: for(int ${blockId}_i = 0; ${blockId}_i < ${inputSignal.getHeight()}; ${blockId}_i++) {
        ${blockId}_loop_j: for(int ${blockId}_j = 0; ${blockId}_j < ${inputSignal.getWidth()}; ${blockId}_j++) {
            if(sfcnIsMajorStep()) {
                Block${blockId}save_data[${blockId}_i][${blockId}_j*${m5}] = ${cparaP.getName()}(${blockId}_i, ${blockId}_j) * ${inputSignal.getName()}(${blockId}_i, ${blockId}_j);
                Block${blockId}save_data[${blockId}_i][${blockId}_j*${m5}+1] = ${cparaD.getName()}(${blockId}_i, ${blockId}_j) * ${inputSignal.getName()}(${blockId}_i, ${blockId}_j);
                Block${blockId}save_data[${blockId}_i][${blockId}_j*${m5}+2] = ${cparaI.getName()}(${blockId}_i, ${blockId}_j) * ${inputSignal.getName()}(${blockId}_i, ${blockId}_j);
            }
            double Block${blockId}_intermediate = Block${blockId}save_data[${blockId}_i][${blockId}_j*${m5}] + 
                                                 ${stateIntegral.getName()}(${blockId}_i, ${blockId}_j) + 
                                                 (Block${blockId}save_data[${blockId}_i][${blockId}_j*${m5}+1] - ${stateFilter.getName()}(${blockId}_i, ${blockId}_j)) * ${cparaN.getName()}(${blockId}_i, ${blockId}_j);

            ## Handle external reset
            #if($externalReset == "on")
            if(${resetSig}) {
                memset(Block${blockId}save_data, 0, sizeof(Block${blockId}save_data));
                Block${blockId}_intermediate = 0;
            }
            #end

            ## Apply output saturation if enabled
            #if($limitOutput == "on")
            ${outputVar}(${blockId}_i, ${blockId}_j) = (Block${blockId}_intermediate > ${upperSaturationLimit.getName()}(${blockId}_i, ${blockId}_j)) ? ${upperSaturationLimit.getName()}(${blockId}_i, ${blockId}_j) : 
                                                      ((Block${blockId}_intermediate < ${lowerSaturationLimit.getName()}(${blockId}_i, ${blockId}_j)) ? ${lowerSaturationLimit.getName()}(${blockId}_i, ${blockId}_j) : Block${blockId}_intermediate);
            #else
            ${outputVar}(${blockId}_i, ${blockId}_j) = Block${blockId}_intermediate;
            #end
        }
        }
    #end
#end