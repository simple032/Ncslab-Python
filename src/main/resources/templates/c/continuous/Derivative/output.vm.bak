/*Code for output of block Derivative:($blockId)$blockName*/
#if($signal && $state)
    #set($outputVar = $outputSignal)
    #set($stateIntegral = $stateName)
    
    #if($solver == "ode1" || $solver == "ode2" || $solver == "ode3" || $solver == "ode4" || $solver == "ode5" || $solver == "ode6")
        ## Fixed-step solver - use backward difference
        #if($signalDataType == $realDataType)
            ## Scalar derivative
            if(sfcnIsMajorStep()) {
                $outputVar = ($signalName - $stateIntegral)/model.stepSize;
                $stateIntegral = $signalName;
            }
        #else
            ## Matrix derivative
            #set($height = $signalHeight)
            #set($width = $signalWidth)
            #set($hMax = $height - 1)
            #set($wMax = $width - 1)
            #foreach($i in [0..$hMax])
                #foreach($j in [0..$wMax])
            if(sfcnIsMajorStep()) {
                $outputVar($i, $j) = ($signalName($i, $j) - $stateIntegral($i, $j))/model.stepSize;
                $stateIntegral($i, $j) = $signalName($i, $j);
            }
                #end
            #end
        #end
    #else
        ## Variable-step solver - use time-based difference
        #if($signalDataType == $realDataType)
            ## Scalar derivative with variable step
            if(sfcnIsMajorStep()) {
                if(model.time > 1e-7) {
                    $outputVar = ($signalName - Block${blockId}yout[0][0])/(model.time - Block${blockId}tout[0][0]);
                    Block${blockId}yout[0][0] = $signalName;
                    Block${blockId}tout[0][0] = model.time;
                } else {
                    $outputVar = 0.0;
                }
            }
        #else
            ## Matrix derivative with variable step
            if(sfcnIsMajorStep()) {
                #set($height = $signalHeight)
                #set($width = $signalWidth)
                #set($hMax = $height - 1)
                #set($wMax = $width - 1)
                #foreach($i in [0..$hMax])
                    #foreach($j in [0..$wMax])
                if(model.time > 1e-7) {
                    $outputVar($i, $j) = ($signalName($i, $j) - Block${blockId}yout[$i][$j])/(model.time - Block${blockId}tout[$i][$j]);
                    Block${blockId}yout[$i][$j] = $signalName($i, $j);
                    Block${blockId}tout[$i][$j] = model.time;
                } else {
                    $outputVar($i, $j) = 0.0;
                }
                    #end
                #end
            }
        #end
    #end
#else
    ## Fallback if parameters missing
    $outputSignal = 0.0; /* Derivative block missing parameters */
#end