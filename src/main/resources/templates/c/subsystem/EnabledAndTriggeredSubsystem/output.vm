#if($triggerBlock)
    bool subsystem_triggered_${blockId} = triggerFlag_${triggerBlock.blockId};
#else
    bool subsystem_triggered_${blockId} = true; // Default triggered if no trigger block
#end

    // ====================================================================
    // STEP 3: Combined Enable AND Trigger Logic
    // ====================================================================
    // Subsystem executes ONLY when BOTH conditions are true:
    //   1. Enable signal is active (enabled == true)
    //   2. Trigger event occurred (triggered == true)

    bool should_execute_${blockId} = subsystem_enabled_${blockId} && subsystem_triggered_${blockId};

    if (should_execute_${blockId}) {
        // ================================================================
        // SUBSYSTEM EXECUTION - Both enabled AND triggered
        // ================================================================

#if($isResetMode)
        // RESET MODE: Check if transitioning from disabled to enabled
        // If so, reset subsystem states to initial conditions
        static bool was_enabled_${blockId} = false;

        if (!was_enabled_${blockId} && subsystem_enabled_${blockId}) {
            // Transitioning from disabled to enabled - RESET STATES
            // Call subsystem initialization to reset all states
            // (Implementation depends on subsystem initialization function)
        }

        was_enabled_${blockId} = subsystem_enabled_${blockId};
#elseif($isHeldMode)
        // HELD MODE: States maintain their values when disabled
        // No special handling needed - states naturally hold their values
        // When re-enabled, execution resumes from held state values
#end

        // Execute subsystem internal logic
        // (Actual subsystem execution code will be inserted here by subsystem code generator)

        // Note: Subsystem execution includes:
        //   - Processing all internal blocks in dependency order
        //   - Updating internal states and outputs
        //   - Propagating data through internal connections

    } else {
        // ================================================================
        // SUBSYSTEM DISABLED - Either not enabled OR not triggered
        // ================================================================

#if($isHeldMode)
        // HELD MODE: States are frozen at current values
        // No computation occurs, but state values are preserved
        // When conditions are met again, execution resumes from held values
#elseif($isResetMode)
        // RESET MODE: States will reset when next enabled
        // Current state values will be discarded
        // Next execution will start from initial conditions
#end

        // No subsystem execution - conditions not met
        // Enable: subsystem_enabled_${blockId}
        // Trigger: subsystem_triggered_${blockId}
    }
}

