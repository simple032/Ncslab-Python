## StringTrim Block - C++ Output Code Template

#if($outputs && $outputs.size() > 0 && $inputs && $inputs.size() > 0)
    // StringTrim: Remove leading/trailing whitespace
    ${outputs.get(0)} = ${inputs.get(0)};
    // Trim leading whitespace
    size_t start = ${outputs.get(0)}.find_first_not_of(" \t\n\r");
    if (start != std::string::npos) {
        ${outputs.get(0)} = ${outputs.get(0)}.substr(start);
    } else {
        ${outputs.get(0)} = "";
    }
    // Trim trailing whitespace
    size_t end = ${outputs.get(0)}.find_last_not_of(" \t\n\r");
    if (end != std::string::npos) {
        ${outputs.get(0)} = ${outputs.get(0)}.substr(0, end + 1);
    }
#end
