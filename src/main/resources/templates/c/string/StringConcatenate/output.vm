##   $blockType - Block type ("StringConcatenate")

/* Code for output of block ${blockType}:(${blockId})${blockName} */
#if($outputs && $outputs.size() > 0)
// Concatenate all input strings
${outputs.get(0)}.clear();

#foreach($input in $inputs)
#if($input && $input != "")
