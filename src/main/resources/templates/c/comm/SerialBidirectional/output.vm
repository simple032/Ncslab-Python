/* Bidirectional Serial Communication block ${blockId} - Send and Receive */

/* Send data (TX) */
#if($inputs.size() > 0)
#set($input = $inputs.get(0))
#if($input.getDataType().name() == "REAL")
/* Send scalar value */
Serial_Send_${blockId}(${input.getName()});
#else
/* Send vector values */
#set($height = $input.getHeight())
for (int i = 0; i < ${height}; i++) {
    Serial_Send_${blockId}(${input.getName()}[i]);
}
#end
#end

/* Receive data (RX) */
#if($outputs.size() > 0)
#set($output = $outputs.get(0))
#if($output.getDataType().name() == "REAL")
/* Receive scalar value */
${output.getName()} = Serial_Receive_${blockId}();
#else
/* Receive vector values */
#set($height = $output.getHeight())
for (int i = 0; i < ${height}; i++) {
    ${output.getName()}[i] = Serial_Receive_${blockId}();
}
#end
#end
