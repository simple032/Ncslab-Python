## Standard context variables from TemplateUtils.populateAllContext()
## Parameter values: $PortValue, $BaudRateValue, $DataBitsValue, $ParityValue, $StopBitsValue, $ByteOrderValue, $FlowControlValue, $TimeoutValue
## SerialConfiguration initialization - configure and open the serial port

// Configure and open serial port ${PortValue} for block ${blockId}
SerialConfig_${blockId} = Serial_Configure_${blockId}("${PortValue}", ${BaudRateValue}, ${DataBitsValue}, "${ParityValue}", "${StopBitsValue}", "${ByteOrderValue}", "${FlowControlValue}", ${TimeoutValue});
if (SerialConfig_${blockId} != NULL) {
    Serial_Open_${blockId}(SerialConfig_${blockId});
}
