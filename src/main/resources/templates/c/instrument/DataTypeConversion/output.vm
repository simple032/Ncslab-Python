## DataTypeConversion block - C code generation
## Convert input data type with specified rounding method
/*Code for output of block $blockType:($blockId)$blockName*/
#set($roundFunc = "floor")
#if($roundingMethod == "Round" || $roundingMethod == "Nearest")
    #set($roundFunc = "round")
#elseif($roundingMethod == "Floor")
    #set($roundFunc = "floor")
#elseif($roundingMethod == "Ceiling" || $roundingMethod == "Ceil")
    #set($roundFunc = "ceil")
#elseif($roundingMethod == "Zero" || $roundingMethod == "Truncate")
    #set($roundFunc = "trunc")
#end

#if($inputs && $inputs.size() > 0)
    #if($inputHeight > 1 || $inputWidth > 1)
        ## Matrix input - apply rounding element-wise with explicit type conversion
        ## Use outputCppType directly to avoid decltype reference type issues
        for(int i = 0; i < ${inputHeight}; i++) {
            #if($inputWidth > 1)
            for(int j = 0; j < ${inputWidth}; j++) {
                ${outputSignal}(i, j) = static_cast<${outputCppType}>(${roundFunc}(${inputSignal}(i, j)));
            }
            #else
            ${outputSignal}(i, 0) = static_cast<${outputCppType}>(${roundFunc}(${inputSignal}(i, 0)));
            #end
        }
    #else
        ## Scalar input - apply rounding function and explicit type conversion
        ${outputSignal} = static_cast<${outputCppType}>(${roundFunc}(${inputSignal}));
    #end
#end
