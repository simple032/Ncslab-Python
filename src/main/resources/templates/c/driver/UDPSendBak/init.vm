/*Code for initialization of block UDPSendBak:(${block.getBlockId()})${block.getBlockName()}*/
sockfd_netsend${block.getBlockId()} = socket(AF_INET, SOCK_DGRAM,0);
if(sockfd_netsend${block.getBlockId()}==-1){printf("can not create socket\n"); close(sockfd_netsend${block.getBlockId()});}
adr_serv_netsend${block.getBlockId()}.sin_family = AF_INET;
adr_serv_netsend${block.getBlockId()}.sin_port =htons(${remoteIPPort});
adr_serv_netsend${block.getBlockId()}.sin_addr.s_addr=inet_addr("${remoteIPAddress}");
int ret =connect(sockfd_netsend${block.getBlockId()},(struct sockaddr*)&adr_serv_netsend${block.getBlockId()},sizeof(adr_serv_netsend${block.getBlockId()}));
if(0>ret){printf("connect error\n");close(sockfd_netsend${block.getBlockId()});}