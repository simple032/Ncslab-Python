/* Code for output of block TappedDelay: (${blockId}) ${blockName} */
// Tapped Delay: ${NumDelays} taps, ${DelayOrder}
#if($DelayOrder == "Oldest first")
// Oldest first order: [x[k], x[k-1], x[k-2], ..., x[k-${NumDelays}]]
${outputVar}[0] = ${inputVar};
for (int i = 0; i < ${NumDelays}; i++) {
    ${outputVar}[i+1] = Block${blockId}_tapped_delay_buffer[i];
}
#else
// Newest first order: [x[k-${NumDelays}], ..., x[k-2], x[k-1], x[k]]
for (int i = 0; i < ${NumDelays}; i++) {
    ${outputVar}[i] = Block${blockId}_tapped_delay_buffer[${NumDelays}-1-i];
}
${outputVar}[${NumDelays}] = ${inputVar};
#end
