/* Code for output of block UnitDelay:(${blockId}) ${blockName} */
/* Buffer-based implementation matching Java calculateOutput() logic */
/* Handles inherited sample time (-1) correctly */
#if($sampleTime && $signal && $initialCondition)
{
    // Handle inherited sample time (-1): use model step size as fallback
    // This matches DiscreteBlock.updateDimension() behavior in Java
    double effectiveSampleTime = (${SampleTimeName} > 0) ? ${SampleTimeName} : mp->stepSize;

    // Check if we're at a sample time using the effective (resolved) sample time
    bool isSampleTime = (effectiveSampleTime > 0) &&
        (fabs(floor(model.time / effectiveSampleTime + 0.5) - model.time / effectiveSampleTime) < 1e-6);

    // Update buffer at sample times (swap previous/current)
    if (isSampleTime && mp->majorStep > 0) {
        // Swap buffer index: 0->1, 1->0
        Block${blockId}_unit_delay_buffer_index = 1 - Block${blockId}_unit_delay_buffer_index;

        // Store current input into the "new current" slot
        int currentSlot = 1 - Block${blockId}_unit_delay_buffer_index;  // The non-previous slot
#if($signalHeight == 1 && $signalWidth == 1)
        // Scalar signal
        Block${blockId}_unit_delay_buffer[currentSlot](0, 0) = ${signalName};
#else
        // Vector/Matrix signal
        Block${blockId}_unit_delay_buffer[currentSlot] = ${signalName};
#end
    }

    // Output the previous value (unit delay behavior) - ALWAYS output
    // Java equivalent: out.setData(previousValue);
    int prevSlot = Block${blockId}_unit_delay_buffer_index;
#if($signalHeight == 1 && $signalWidth == 1)
    ${output1} = Block${blockId}_unit_delay_buffer[prevSlot](0, 0);
#else
    ${output1} = Block${blockId}_unit_delay_buffer[prevSlot];
#end
}
#else
    // Fallback if parameters missing
    ${output1} = 0.0; /* UnitDelay parameters missing, using default */
#end
