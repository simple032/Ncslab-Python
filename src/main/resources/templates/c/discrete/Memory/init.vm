/* Code for initialization of block Memory:(${blockId}) ${blockName} */
${sampleTime.getInitCodeC()}
${initialCondition.getInitCodeC()}
sample_time[sample_i] = ${SampleTimeName};
sample_i = sample_i + 1;

// Initialize memory buffer with initial condition
{
#if($signalHeight == 1 && $signalWidth == 1)
    // Scalar signal: Create 1x1 matrices
    Matrix icMatrix(1, 1);
    icMatrix(0, 0) = ${InitialConditionName};
    Block${blockId}_memory_buffer[0] = icMatrix;
    Block${blockId}_memory_buffer[1] = icMatrix;
#else
    // Vector/Matrix signal
    Matrix icMatrix(${signalHeight}, ${signalWidth});
    #if($InitialConditionObject.getData().getDataType().toString() == "MATRIX")
    // IC is already a Matrix - use it directly
    icMatrix = ${InitialConditionName};
    #else
    // IC is scalar - expand to match signal dimensions
    icMatrix.setConstant(${InitialConditionName});
    #end
    Block${blockId}_memory_buffer[0] = icMatrix;
    Block${blockId}_memory_buffer[1] = icMatrix;
#end
    Block${blockId}_memory_buffer_index = 0;
}
