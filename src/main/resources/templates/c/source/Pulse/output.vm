        ${outputVar}[$i][$j] = 0.0;
    } else if(((int)((model.time-${PhaseDelay}[$i][$j])*100) % (int)(${Period}[$i][$j]*100)) < ${Period}[$i][$j]*${PulseWidth}[$i][$j]) {
        ${outputVar}[$i][$j] = ${Amplitude}[$i][$j];
    } else {
        ${outputVar}[$i][$j] = 0.0;
