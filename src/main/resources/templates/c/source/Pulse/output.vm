    if(model.time < ${PhaseDelay}) {
        ${outputVar} = 0.0;
    } else if(((int)((model.time-${PhaseDelay})*100) % (int)(${Period}*100)) < ${Period}*${PulseWidth}) {
        ${outputVar} = ${Amplitude};
    } else {
        ${outputVar} = 0.0;
    }
#else
    ## Matrix pulse generation
    #foreach($i in [0..$hMax])
        #foreach($j in [0..$wMax])
