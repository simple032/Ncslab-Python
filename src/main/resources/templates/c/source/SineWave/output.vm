/*Code for output of block SineWave:($blockId)$blockName*/
#if($Amplitude && $Bias && $Frequency && $Phase)
    #if($AmplitudeObject.dataType == $realDataType)
        ## Scalar sine wave
        $outputSignal = $Bias + $Amplitude * sin($Frequency * model.time + $Phase);
    #else
        ## Matrix sine wave - using parameter objects for dimension info
        #set($height = $AmplitudeObject.height)
        #set($width = $AmplitudeObject.width)
        #set($hMax = $height - 1)
        #set($wMax = $width - 1)
        #foreach($i in [0..$hMax])
            #foreach($j in [0..$wMax])
        $outputSignal[$i][$j] = $Bias[$i][$j] + $Amplitude[$i][$j] * sin($Frequency[$i][$j] * model.time + $Phase[$i][$j]);
            #end
        #end
    #end
#else
    ## Fallback with default values
    $outputSignal = 1.0 * sin(1.0 * model.time + 0.0); /* Using default sine wave parameters */
#end
