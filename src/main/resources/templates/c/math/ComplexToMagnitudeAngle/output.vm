    $outputMagVar = sqrt(${inputReVar} * ${inputReVar} + ${inputImVar} * ${inputImVar});
    ## Angle = atan2(im, re)
    #if($useDegrees)
    $outputAngleVar = atan2(${inputImVar}, ${inputReVar}) * 180.0 / M_PI;  // Convert to degrees
