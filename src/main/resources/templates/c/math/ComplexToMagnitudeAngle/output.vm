        ${outputMagVar}($i, $j) = sqrt(${inputReVar}($i, $j) * ${inputReVar}($i, $j) + ${inputImVar}($i, $j) * ${inputImVar}($i, $j));
        ## Angle for element (i,j)
        #if($useDegrees)
        ${outputAngleVar}($i, $j) = atan2(${inputImVar}($i, $j), ${inputReVar}($i, $j)) * 180.0 / M_PI;  // Degrees
