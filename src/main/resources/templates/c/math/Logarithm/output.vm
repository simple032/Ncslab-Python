
#if($inputHeight == 1 && $inputWidth == 1)
    ## Scalar logarithm with domain validation
    if(${inputVar} > 0.0) {
    #if($LogTypeValue == "log" || $LogTypeValue == "ln")
        ${outputVar} = log(${inputVar});  // Natural logarithm
    #elseif($LogTypeValue == "log2")
        ${outputVar} = log2(${inputVar});  // Log base 2
    #elseif($LogTypeValue == "log10")
        ${outputVar} = log10(${inputVar});  // Log base 10
    #elseif($LogTypeValue == "custom")
        ${outputVar} = log(${inputVar}) / log(${CustomBase});  // Custom base
    #else
        ${outputVar} = log(${inputVar});  // Default to natural logarithm
