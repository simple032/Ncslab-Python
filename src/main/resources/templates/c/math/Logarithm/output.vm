    #set($hMax = $inputHeight - 1)
    #set($wMax = $inputWidth - 1)
    #foreach($i in [0..$hMax])
        #foreach($j in [0..$wMax])
    if(${inputVar}($i, $j) > 0.0) {
            #if($LogTypeValue == "log" || $LogTypeValue == "ln")
        ${outputVar}($i, $j) = log(${inputVar}($i, $j));  // Natural logarithm
            #elseif($LogTypeValue == "log2")
        ${outputVar}($i, $j) = log2(${inputVar}($i, $j));  // Log base 2
            #elseif($LogTypeValue == "log10")
        ${outputVar}($i, $j) = log10(${inputVar}($i, $j));  // Log base 10
