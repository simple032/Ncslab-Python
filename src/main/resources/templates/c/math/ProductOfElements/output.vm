/*Code for output of block ProductOfElements:($blockId)$blockName*/
## ProductOfElements: multiply/divide elements based on sequence parameter
#if($inputHeight == 1 && $inputWidth == 1)
    ## Scalar input
    #if($sequence.length() == 1)
    ${outputVar} = ${inputVar};
    #else
    ${outputVar} = 1;
        #set($seqMax = $sequence.length() - 1)
        #foreach($i in [0..$seqMax])
    ${outputVar} $sequence.charAt($i)= ${inputVar};
        #end
    #end
#else
    ## Matrix input
    #if($allDimensions)
        ## Element-wise product over all dimensions
    ${outputVar} = 1;
        #set($hMax = $inputHeight - 1)
        #set($wMax = $inputWidth - 1)
        #foreach($m in [0..$hMax])
            #foreach($n in [0..$wMax])
    ${outputVar}[$m][$n] = 1;
                #set($seqMax = $sequence.length() - 1)
                #foreach($i in [0..$seqMax])
    ${outputVar}[$m][$n] $sequence.charAt($i)= ${inputVar}[$m][$n];
                #end
            #end
        #end
    #else
        ## Product along specific dimension
        #if($dimension == 2)
            ## Product along columns (output is row vector)
            #set($mMax = $inputWidth - 1)
            #foreach($m in [0..$mMax])
    ${outputVar}[0][$m] = 1;
                #set($nMax = $inputHeight - 1)
                #foreach($n in [0..$nMax])
    ${outputVar}[0][$m] *= ${inputVar}[$n][$m];
                #end
            #end
        #else
            ## Product along rows (output is column vector)
            #set($mMax = $inputHeight - 1)
            #foreach($m in [0..$mMax])
    ${outputVar}[$m][0] = 1;
                #set($nMax = $inputWidth - 1)
                #foreach($n in [0..$nMax])
    ${outputVar}[$m][0] *= ${inputVar}[$m][$n];
                #end
            #end
        #end
    #end
