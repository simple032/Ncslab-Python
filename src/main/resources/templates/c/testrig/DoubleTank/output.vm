/* Code for output of block DoubleTank:($blockId)$blockName */

#if ($modelMode == $compilationMode)
    // Compilation mode - Hardware operation for actual double tank system
    if ($stateX0 <= $lb_position) {
        $output1 = $lb_position;
    } else if (($stateX0 > $lb_position) && ($stateX0 <= $ub_angle)) {
        $output1 = $stateX0;
    } else {
        $output1 = $ub_angle;
    }

    $output2 = $stateX1;
    $output3 = $rwork_tem * 180 / AERO_PI;

#elseif ($modelMode == $simulationMode)
    // Simulation mode - Mathematical model for double tank water level system
    // Output 1: Pump Speed (proportional to input)
    $output1 = $input1 > 0 ? $input1 : 0;
    
    // Output 2: Water Level (from state variable)
    $output2 = $stateX1;
    
    // Output 3: Flow rate or tank level indicator
    $output3 = $stateX0 * 100 / 3.14159; // Convert to percentage or flow rate
#end
