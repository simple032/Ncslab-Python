/*Code for Output of MagneticLevitationSystem:(${block.blockId})${block.blockName}*/
#if ($modelMode == $compilationMode)
    // Compilation mode - Hardware operation for actual magnetic levitation system
    $outputPosition = -100 / 4.587156 * $position;
    $outputVelocity = $velocity;
#elseif ($modelMode == $simulationMode)
    // Simulation mode - Mathematical model for magnetic levitation system
    // Uses system states to calculate position and velocity outputs
    $outputPosition = -100 / 4.587156 * $position;  // Position measurement (scaled)
    $outputVelocity = $velocity;                    // Velocity measurement
#end