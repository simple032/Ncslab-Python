/*Code for Derivative of MagneticLevitationSystem:(${block.blockId})${block.blockName}*/
{
#if ($modelMode == $simulationMode)
/* Simulation mode - Magnetic Levitation System dynamics */
/* Physical constants and parameters */
double g = 9.8;    /* gravity */
double x0 = 0.2;   /* equilibrium position */
double i0 = 6.105; /* equilibrium current */
double Ks = -4.5871056; /* transducer voltage constant */
double Ka = 5.8929; /* input resistance */

/* Current input signal */
double u = $inputPortVariable;

/* State variables: position (x0) and velocity (x1) */
double x = $position;
double v = $velocity;

/* Magnetic levitation dynamics - position derivative is velocity */
$positionDerivative = v;

/* Velocity derivative - magnetic force vs gravity */
/* Simplified magnetic force model: F_mag = K * i^2 / x^2 */
double K_mag = 0.001; /* magnetic force constant */
double current = u;   /* input current */
double mag_force = (x > 0.01) ? K_mag * current * current / (x * x) : 0;
$velocityDerivative = g - mag_force;

#else
/* Hardware mode - simple dynamics */
$positionDerivative = $velocity;
$velocityDerivative = $inputPortVariable - 9.8;
#end
}