/*Code for output of BallPlateSystem::($blockId)$blockName*/
#if ($modelMode == $simulationMode)
/* BallPlateSystem simulation output */
#if ($outputPortList && $outputPortList.size() > 0)
$outputPortList.get(0).outputSignalC.name = x0;  /* Position */
