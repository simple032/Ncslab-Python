#elseif ($modelMode == $simulationMode)
    // Simulation mode - Mathematical model for xz inverted pendulum SUST system
    // Simulates SUST (Shanghai University of Science and Technology) pendulum dynamics
    static double pendulum_angle_xz = 0.0;
    static double cart_position_xz = 0.0;
    static double pendulum_velocity_xz = 0.0;
    static double cart_velocity_xz = 0.0;
    static bool position_reset = false;
    
    // Input processing
    #if($inputPortVariable1)
    int control_input = ${inputPortVariable1};
    #end
    #if($inputPortVariable2)
    int speed_input = ${inputPortVariable2};
    #end
    bool enable_flag = (int)${ENAOrDIS.name} == 1;
    bool pos_reset_flag = (int)${POS0Flag.value} == 1;
    
    // Position reset logic
    if (pos_reset_flag && !position_reset) {
        cart_position_xz = 0.0;
        pendulum_angle_xz = 0.0;
        position_reset = true;
    } else if (!pos_reset_flag) {
        position_reset = false;
    }
    
    // Dynamics simulation
    if (enable_flag && mp->majorStep > 0) {
        double dt = mp->sampleTime;
        
        // Control force calculation
        float force_tmp = control_input / 9.424776;
        double control_force = (control_input >= 0) ? force_tmp : -force_tmp;
        
        // Speed control
        double target_velocity = enable_flag ? speed_input : 0.0;
        if (control_input < 0) target_velocity = -target_velocity;
        
        // Simplified pendulum-cart dynamics
        double pendulum_accel = sin(pendulum_angle_xz * M_PI / 180.0) * 9.81 - cart_velocity_xz * 0.1;
        pendulum_velocity_xz += pendulum_accel * dt;
        pendulum_angle_xz += pendulum_velocity_xz * dt * 180.0 / M_PI;
        
        // Cart dynamics
        double cart_accel = (control_force - cart_position_xz * 0.5) / 1.0;
        cart_velocity_xz += cart_accel * dt;
        cart_position_xz += cart_velocity_xz * dt;
        
        // Keep angle in reasonable range
        if (pendulum_angle_xz > 180.0) pendulum_angle_xz -= 360.0;
        if (pendulum_angle_xz < -180.0) pendulum_angle_xz += 360.0;
    }
    
    ${outputPortVariable1} = cart_position_xz;      // Cart position output
    ${outputPortVariable2} = pendulum_angle_xz;     // Pendulum angle output
#end