    /*Code for output of block xzInvertedPendulumSUST:(${block.blockId})${block.blockName}*/
    if(mp->majorStep>0){
    char recvBuffXzIPSUST[255]={0};
    char sendBuffXzIPSUST[]={"GZ999POS*=?\r\n"};
    if(xzIPSUSTbool==false) {Serialport_Send(hCommXzIPSUST,sendBuffXzIPSUST,strlen(sendBuffXzIPSUST));
     char cmdClearPos[] = {"GZ999POS*=0\r\n"};
    if((int)${POS0Flag.value}==1) {Serialport_Send(hCommXzIPSUST,cmdClearPos,strlen(cmdClearPos));
    usleep(3000);}
    }char xzcmd[50]={0},xzcmd2[50]={0};
    #if($inputPortVariable1)
    int xztmp = ${inputPortVariable1};
    float xzacctmp = xztmp/9.424776;
    float xzacc = (xztmp>=0)?xzacctmp:-xzacctmp;
    int xzaccInt=(int)xzacc;
    #end
    #if($inputPortVariable2)
    int VspeedValue = (int)${inputPortVariable2}>0?${inputPortVariable2}:-${inputPortVariable2};
    #end
    #if($inputPortVariable1)
    sprintf((char*)xzcmd,"GZ100A%d\r\n",xzaccInt);if(xzIPSUSTbool==false)Serialport_Recv(hCommXzIPSUST,recvBuffXzIPSUST,62);
    #end
    printf("recvBuff=%s\n",recvBuffXzIPSUST);
    if(xzIPSUSTbool==true) Serialport_Send(hCommXzIPSUST,xzcmd,strlen(xzcmd));
    #if($inputPortVariable1)
    if(xztmp<0&&(int)${ENAOrDIS.name}==1) sprintf((char*)xzcmd2,"GZ000V-%d\r\n",VspeedValue);
    else if(xztmp>0&&(int)${ENAOrDIS.name}==1) sprintf((char*)xzcmd2,"GZ000V%d\r\n",VspeedValue);
    #end
    else sprintf((char*)xzcmd2,"GZ000V0\r\n");
    if(xzIPSUSTbool==true)usleep(3000);
    if(xzIPSUSTbool==true) Serialport_Send(hCommXzIPSUST,xzcmd2,strlen(xzcmd2));
    char xzheadStr[]={"POS"};
    int xzpos1=0,xzpos2=0;
    char *xzkeyStart = strstr(recvBuffXzIPSUST,xzheadStr);
    if(xzkeyStart!=NULL){
    xzkeyStart+=3;
    xzpos1 = strtol(xzkeyStart,&xzkeyStart,10);
    xzpos2 = strtol(xzkeyStart+1,NULL,10);
    xzxPOS = xzpos2*360.0/(16*2000.0);
    xzAngle = (xzpos1%4000)*360.0/4000.0;
