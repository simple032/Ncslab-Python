#if ($modelMode == $compilationMode)
    // Compilation mode - Hardware operation for actual Telegenic system measurements
    #if ($DA)
    DAC8532_Out_Voltage(channel_B, $input);
    #else
    DAC8532_Out_Voltage(channel_A, ($input) / 4);
    #end

    $outputAD1 = ADS1256_GetChannalValue($AD1) * 5.0 / 0x7fffff;
    $outputAD2 = ADS1256_GetChannalValue($AD2) * (-16.6666667) / 0x7fffff;
    $outputAD3 = ADS1256_GetChannalValue($AD3) * (-5.0) / 0x7fffff;
    $outputAD4 = ADS1256_GetChannalValue($AD4) * 5.0 / 0x7fffff;
    $outputAD5 = ADS1256_GetChannalValue($AD5) * 5.0 / 0x7fffff;
    $outputAD6 = ADS1256_GetChannalValue($AD6) * (-16.6666667) / 0x7fffff;
    $outputAD7 = ADS1256_GetChannalValue($AD7) * (-16.6666667) / 0x7fffff;
#elseif ($modelMode == $simulationMode)
    // Simulation mode - Mathematical model for Telegenic system
    // Simulates multi-channel data acquisition and control output
    
    // Simulate analog output (no DAC operations)
    double control_output = $input;
    
    // Simulate multi-channel analog input readings
    double time = getTimeStep();
    $outputAD1 = sin(time * 0.1 + control_output * 0.01) * 2.5 + 2.5;       // Voltage channel (0-5V)
    $outputAD2 = cos(time * 0.12 + control_output * 0.02) * (-8.33) - 8.33;  // Current channel 1 (negative)
    $outputAD3 = sin(time * 0.08 + control_output * 0.015) * (-2.5) - 2.5;   // Voltage channel 2 (negative)
    $outputAD4 = cos(time * 0.15 + control_output * 0.025) * 2.5 + 2.5;      // Voltage channel 3 (positive)
    $outputAD5 = sin(time * 0.11 + control_output * 0.018) * 2.5 + 2.5;      // Voltage channel 4 (positive)
    $outputAD6 = cos(time * 0.09 + control_output * 0.022) * (-8.33) - 8.33; // Current channel 2 (negative)
    $outputAD7 = sin(time * 0.13 + control_output * 0.028) * (-8.33) - 8.33; // Current channel 3 (negative)
#end