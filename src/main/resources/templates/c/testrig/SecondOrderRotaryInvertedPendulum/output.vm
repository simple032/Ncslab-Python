#if ($modelMode == $compilationMode)
    // Compilation mode - Hardware operation for actual second-order rotary inverted pendulum system
    /* Velocity Template for output of block SecondOrderRotaryInvertedPendulum */
    union float_data
    {
        float f_data;
        uint8_t byte[4];
    }tx_float_data,rx_Angle_float_data,rx_xSet_float_data,rx_x_float_data;

    if(mp->majorStep>0){
        char recvBuff[255]={0};

        Serialport_Recv(hComm,recvBuff,17);

        for(int i=0;i<17-12;i++){
            if(recvBuff[i]==0x05&&recvBuff[i+1]==0x03&&recvBuff[i+2]==0xE1){
                rx_Angle_float_data.byte[0]=recvBuff[i+3];
                rx_Angle_float_data.byte[1]=recvBuff[i+4];
                rx_Angle_float_data.byte[2]=recvBuff[i+5];
                rx_Angle_float_data.byte[3]=recvBuff[i+6];

                rx_xSet_float_data.byte[0]=recvBuff[i+7];
                rx_xSet_float_data.byte[1]=recvBuff[i+8];
                rx_xSet_float_data.byte[2]=recvBuff[i+9];
                rx_xSet_float_data.byte[3]=recvBuff[i+10];

                rx_x_float_data.byte[0]=recvBuff[i+11];
                rx_x_float_data.byte[1]=recvBuff[i+12];
                rx_x_float_data.byte[2]=recvBuff[i+13];
                rx_x_float_data.byte[3]=recvBuff[i+14];
                break;
            }
        }
        Serialport_Flush(hComm);

        float Angle=rx_Angle_float_data.f_data;
        float xSet=rx_xSet_float_data.f_data;
        float x=rx_x_float_data.f_data;

        $output1=Angle;
        $output2=xSet;
        $output3=x;

        unsigned char cmd[]={0x00,0x00,0x00,0x00,0x00,0x0D,0x0A};
        float xSet2 = $input;
        tx_float_data.f_data = xSet2;
        cmd[1] = tx_float_data.byte[0];
        cmd[2] = tx_float_data.byte[1];
        cmd[3] = tx_float_data.byte[2];
        cmd[4] = tx_float_data.byte[3];
        cmd[0] = calcSum(cmd);
        Serialport_Send(hComm,cmd,7);
    }
#elseif ($modelMode == $simulationMode)
    // Simulation mode - Mathematical model for second-order rotary inverted pendulum system
    // Combines rotary motion with second-order pendulum dynamics
    static double pendulum_angle = 0.0;
    static double pendulum_velocity = 0.0;
    static double arm_angle = 0.0;
    static double arm_velocity = 0.0;
    
    // Second-order rotary pendulum parameters
    double dt = mp->sampleTime;
    double torque_input = $input;
    
    // Rotary arm dynamics (second-order)
    double arm_accel = (torque_input - arm_angle * 0.2 - arm_velocity * 0.1) / 1.0;
    arm_velocity += arm_accel * dt;
    arm_angle += arm_velocity * dt;
    
    // Pendulum dynamics coupled with arm motion
    double coupling_force = arm_velocity * cos(arm_angle) * 0.5;
    double pendulum_accel = sin(pendulum_angle) * 9.81 + coupling_force - pendulum_velocity * 0.05;
    pendulum_velocity += pendulum_accel * dt;
    pendulum_angle += pendulum_velocity * dt;
    
    $output1 = pendulum_angle;      // Pendulum angle
    $output2 = torque_input;        // Torque setpoint
    $output3 = arm_angle;           // Rotary arm angle
#end