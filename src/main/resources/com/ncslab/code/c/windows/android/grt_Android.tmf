# Copyright 2014-2018 Harbin Institute of technology.
#
# File    : grt_Android.tmf   $Revision: 1.0 $Date:July 7, 2014
#
# Abstract:
#       Real-Time Workshop template makefile for building a ucLinux-based 
#       stand-alone generic real-time version of Simulink model using 
#       generated C code and the GNU arm-linux-gcc compiler versions: 2.95
#
#       Note that this template is automatically customized by the Real-Time
#       Workshop build procedure to create "<model>.mk"
#
#       The following defines can be used to modify the behavior of the
#       build:
#
#    	  OPT_OPTS       - Optimization option. Default is -O2. To enable
#    			   debugging specify as OPT_OPTS=-Zd.
#    	  OPTS           - User specific options.
#    	  USER_SRCS      - Additional user sources, such as files needed by
#    			   S-functions.
#    	  USER_INCLUDES  - Additional include paths 
#    			   (i.e. USER_INCLUDES="-Iwhere-ever -Iwhere-ever2")
#
#       This template makefile is designed to be used with a system target
#       file that contains 'rtwgensettings.BuildDirSuffix' see grt.tlc


#------------------------ Macros read by make_arm -----------------------------
#
# The following macros are read by the Real-Time Workshop build procedure:
#
#  MAKECMD         - This is the command used to invoke the make utility
#  HOST            - What platform this template makefile is targeted for 
#                    (i.e. PC or UNIX)
#  BUILD           - Invoke make from the Real-Time Workshop build procedure 
#                    (yes/no)?
#  SYS_TARGET_FILE - Name of system target file.

MAKECMD         = make
HOST            = ANY
BUILD           = yes
SYS_TARGET_FILE = grt_Android.tlc

#---------------------- Tokens expanded by make_arm ---------------------------
#
# The following tokens, when wrapped with "|>" and "|<" are expanded by the 
# Real-Time Workshop build procedure.
#   
#  MODEL_NAME          - Name of the Simulink block diagram
#  MODEL_MODULES       - Any additional generated source modules
#  MAKEFILE_NAME       - Name of makefile created from template makefile <model>.mk
#  MATLAB_ROOT         - Path to were MATLAB is installed. 
#  MATLAB_BIN          - Path to MATLAB executable.
#  S_FUNCTIONS         - List of S-functions.
#  S_FUNCTIONS_LIB     - List of S-functions libraries to link.
#  SOLVER              - Solver source file name
#  NUMST               - Number of sample times
#  TID01EQ             - yes (1) or no (0): Are sampling rates of continuous task 
#                        (tid=0) and 1st discrete task equal.
#  NCSTATES            - Number of continuous states
#  BUILDARGS           - Options passed in at the command line.
#  MULTITASKING        - yes (1) or no (0): Is solver mode multitasking
#  EXT_MODE            - yes (1) or no (0): Build for external mode
#  TMW_EXTMODE_TESTING - yes (1) or no (0): Build ext_test.c for external mode
#                        testing.

MODEL                = |>MODEL_NAME<|
MODULES              = |>MODEL_MODULES<|
MAKEFILE             = |>MAKEFILE_NAME<|
MATLAB_ROOT          = |>MATLAB_ROOT<|
ALT_MATLAB_ROOT      = |>ALT_MATLAB_ROOT<|
S_FUNCTIONS          = |>S_FUNCTIONS<|
S_FUNCTIONS_LIB      = |>S_FUNCTIONS_LIB<|
USER_DEFINE_FUNCTIONS = |>USER_DEFINE_FUNCTIONS<|
SOLVER               = |>SOLVER<|
NUMST                = |>NUMST<|
TID01EQ              = |>TID01EQ<|
NCSTATES             = |>NCSTATES<|
BUILDARGS            = |>BUILDARGS<|
MULTITASKING         = |>MULTITASKING<|
EXT_MODE             = |>EXT_MODE<|
EXT_FIRST_EXECUTE    = |>EXT_FIRST_EXECUTE<|
TMW_EXTMODE_TESTING  = |>TMW_EXTMODE_TESTING<|
NetCon_Address       = |>NETCON_IP_ADDRESS<|
IP_Address := $(subst ", ,$(NetCon_Address))

#MATLAB_ROOT := $(shell cygpath -u "|>MATLAB_ROOT<|")
MATLAB_ROOTA := $(subst \,/,"|>MATLAB_ROOT<|")

#-- In the case when directory name contains space ---
ifneq ($(MATLAB_ROOT),$(ALT_MATLAB_ROOT))
MATLAB_ROOTA := $(ALT_MATLAB_ROOT)
endif


#--------------------------- Tool Specifications ------------------------------
#<-CROSSCOMPILE->

ANDROIDDIR    =  |>NDK<|


CC	= $(ANDROIDDIR)/bin/arm-linux-androideabi-gcc
LD  = $(ANDROIDDIR)/bin/arm-linux-androideabi-gcc

RM	= rm -f

#------------------------------ Include Path ------------------------------


MATLAB_INCLUDES =  \
	-I$(MATLAB_ROOT)/rtw/c/src	\
	-I$(MATLAB_ROOT)/extern/include	\
	-I$(MATLAB_ROOT)/simulink/include	\
	-I$(MATLAB_ROOT)/rtw/c/libsrc    \
	-I$(MATLAB_ROOT)/toolbox/dspblks/include \
	-I$(MATLAB_ROOT)/toolbox/netcon \
	-I$(MATLAB_ROOT)/toolbox/coder/rtiostream/src/utils \
	-I$(MATLAB_ROOT)/rtw/c/netcon_android/common \
	-I$(MATLAB_ROOT)/toolbox/netcon_toolbox_mod

USER_INCLUDES = -I$(ANDROIDDIR)/sysroot

ADD_INCLUDES = \
|>START_EXPAND_INCLUDES<|	-I|>EXPAND_DIR_NAME<| \
|>END_EXPAND_INCLUDES<|
ADD_INCLUDES := $(subst \,/,$(ADD_INCLUDES))
INCLUDE = -I. -I.. $(MATLAB_INCLUDES) $(ADD_INCLUDES) $(USER_INCLUDES) 
	

#------------------------ External mode ---------------------------------------
# uncomment -DVERBOSE to have information printed to stdout
EXT_MODE=1       
EXT_CC_OPTS =  -DEXT_MODE  #-DVERBOSE

#------------------------ rtModel ----------------------------------------------

RTM_CC_OPTS = -DUSE_RTMODEL

#----------------- Compiler and Linker Options --------------------------------

# Optimization Options
DEFAULT_OPT_OPTS = -O2
ifndef OPT_OPTS
OPT_OPTS = $(DEFAULT_OPT_OPTS)
endif

# General User Options
OPTS =
CC_OPTS = $(OPT_OPTS) $(OPTS) $(EXT_CC_OPTS) $(RTM_CC_OPTS)

CPP_REQ_DEFINES = -DMODEL=$(MODEL) -DRT -DNUMST=$(NUMST) \
		  -DTID01EQ=$(TID01EQ) -DNCSTATES=$(NCSTATES) \
		  -DMT=$(MULTITASKING) -DHAVESTDIO
		  
CFLAGS	= -Wall -Dlinux -D__linux__ -Dunix  -DNO_UNDERSCORES=1 -pie -fPIE
LDFLAGS = -Wl  -DHAVE_PTHREADS 

#----------------------------- Source Files -----------------------------------

ifneq ($(findstring $(MODEL)_data.c, $(MODULES)),)
  REQ_SRCS  = $(MODEL)_data.c 
endif 
  REQ_SRCS  += rt_nonfinite.c  \
  $(MATLAB_ROOT)/rtw/c/src/rt_sim.c  \
  $(MODEL).c \
  $(MODEL)_capi.c \
  $(MATLAB_ROOT)/rtw/c/netcon_android/main.c  \

ifneq ($(findstring rt_look.c, $(MODULES)),)
  REQ_SRCS  += rt_look.c
endif
ifneq ($(findstring rt_look1d.c, $(MODULES)),)
  REQ_SRCS  += rt_look1d.c 
endif
ifneq ($(findstring rt_rand.c, $(MODULES)),)
  REQ_SRCS  += rt_rand.c 
endif
ifneq ($(findstring rt_zcfcn.c, $(MODULES)),)
  REQ_SRCS  += rt_zcfcn.c 
endif
ifneq ($(findstring rt_hypot.c, $(MODULES)),)
  REQ_SRCS  += rt_hypot.c 
endif
ifneq ($(SOLVER), )
  REQ_SRCS	+= $(MATLAB_ROOT)/rtw/c/src/$(SOLVER)
endif 

  REQ_SRCS	+= $(S_FUNCTIONS)
  REQ_SRCS	+= $(USER_DEFINE_FUNCTIONS)


 REQ_SRCS  += rtGetInf.c
 REQ_SRCS  += rtGetNaN.c
 
 REQ_SRCS  +=rt_matrx.c
 REQ_SRCS  +=rt_logging.c
 REQ_SRCS  +=ext_work.c
 REQ_SRCS  +=ext_svr.c
 REQ_SRCS  +=updown.c
 #REQ_SRCS  +=$(MATLAB_ROOT)/rtw/c/src/ext_mode/common/rtiostream_interface.c
 REQ_SRCS  +=$(MATLAB_ROOT)/rtw/c/netcon_android/common/ext_svr_custom_transport.c
 
 USER_SRCS += 

REQ_SRCS+=$(USER_SRCS)

SRCS = $(REQ_SRCS)
OBJSO = $(SRCS:.c=.o)  
OBJS = $(OBJSO)

OBJS += $(OBJS_USER)

# ------------------------- Additional Libraries ------------------------------
#<-NETCON_LDIR->
#NETCON_LDIR :=
#LIBPATH = -L$(MATLAB_ROOT)/rtw/c/netcon_android/lib
SYSLIBS = -lm 
#LIBS =-ldsp_rt
#LIBS +=-lrtwlib

#--------------------------------- Rules --------------------------------------

ifneq ($(EXT_FIRST_EXECUTE),0)
	HEAD:= dos2linux $(MODEL) 
else
	HEAD:= $(MODEL) 
endif

#<-CP_SFUNCTIONS->
REQ_SRCS_C  := $(shell ls *.c)
REQ_SRCS_H  := $(shell ls *.h)
REQ_SRCS_MK := $(shell ls *.mk)

all: $(HEAD) clean

$(MODEL): $(OBJSO) 
	@echo "linking..."
	$(LD) $(CFLAGS) $(INCLUDE) $(LDFLAGS) -o $@ $(OBJS) -lm #$(LIBPATH) $(LIBS) 
	@chmod 755 $(MODEL)
	@echo "### Created executable flat file: $(MODEL) successfully by grt_android.tmf"

clean:
	@echo "### delete intermediate files"
	$(RM) $(OBJSO)

dos2linux:
	@dos2unix $(MATLAB_ROOT)/extern/include/*.h $(MATLAB_ROOT)/rtw/c/libsrc/*.h $(MATLAB_ROOT)/rtw/c/src/*.h \                  $(MATLAB_ROOT)/toolbox/dspblks/include/*.h $(MATLAB_ROOT)/simulink/include/*.h


.SUFFIXES:
.SUFFIXES: .c .o
	
%.o:%.c 
	$(CC) $(CFLAGS) $(EXT_CC_OPTS) $(RTM_CC_OPTS) $(CPP_REQ_DEFINES) $(INCLUDE) -c $< -o $@
%.o : $(MATLAB_ROOT)/simulink/src/%.c
	$(CC) $(CFLAGS) $(EXT_CC_OPTS) $(RTM_CC_OPTS) $(CPP_REQ_DEFINES) $(INCLUDE) -c $< -o $@	
%.o : $(MATLAB_ROOT)/toolbox/netcon/%.c
	$(CC) $(CFLAGS) $(EXT_CC_OPTS) $(RTM_CC_OPTS) $(CPP_REQ_DEFINES) $(INCLUDE) -c $< -o $@
%.o : $(MATLAB_ROOT)/toolbox/netcon_toolbox_mod/%.c
	$(CC) $(CFLAGS) $(EXT_CC_OPTS) $(RTM_CC_OPTS) $(CPP_REQ_DEFINES) $(INCLUDE) -c $< -o $@
%.o : $(MATLAB_ROOT)/rtw/c/src/%.c
	$(CC) $(CFLAGS) $(EXT_CC_OPTS) $(RTM_CC_OPTS) $(CPP_REQ_DEFINES) $(INCLUDE) -c $< -o $@	
%.o : $(MATLAB_ROOT)/rtw/c/netcon_android/common/%.c
	$(CC) $(CFLAGS) $(EXT_CC_OPTS) $(RTM_CC_OPTS) $(CPP_REQ_DEFINES) $(INCLUDE) -c $< -o $@
%.o : ../%.c
	$(CC) $(CFLAGS) $(EXT_CC_OPTS) $(RTM_CC_OPTS) $(CPP_REQ_DEFINES) $(INCLUDE) -c $< -o $@

#------------------------------- Libraries -------------------------------------

|>START_EXPAND_LIBRARIES<|MODULES_|>EXPAND_LIBRARY_NAME<| = \
|>START_EXPAND_MODULES<|	|>EXPAND_MODULE_NAME<|.o \
|>END_EXPAND_MODULES<|

|>EXPAND_LIBRARY_NAME<|.a : $(MAKEFILE) rtw_proj.tmw $(MODULES_|>EXPAND_LIBRARY_NAME<|)
	@echo "### Creating $@ "
	@ar -r $@ $(MODULES_|>EXPAND_LIBRARY_NAME<|)
	@echo "### Created $@"

|>END_EXPAND_LIBRARIES<|

|>START_PRECOMP_LIBRARIES<|MODULES_|>EXPAND_LIBRARY_NAME<| = \
|>START_EXPAND_MODULES<|	|>EXPAND_MODULE_NAME<|.o \
|>END_EXPAND_MODULES<|

|>EXPAND_LIBRARY_NAME<|.a : $(MAKEFILE) rtw_proj.tmw $(MODULES_|>EXPAND_LIBRARY_NAME<|)
	@echo "### Creating $@ "
	@ar -r $@ $(MODULES_|>EXPAND_LIBRARY_NAME<|)
	@echo "### Created $@"

|>END_PRECOMP_LIBRARIES<|